@page "/themes"
@inject themes.Services.ThemeCatalogService Catalog
@inject NavigationManager Navigation

@code {
    [SupplyParameterFromQuery(Name = "id")] public string? Id { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? Name { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var resolution = await Catalog.ResolveAsync(Id, Name);
        Navigation.NavigateTo(resolution.ManifestPath, forceLoad: true);
    }
}
