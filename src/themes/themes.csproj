<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <ThemeVersionFile>$(MSBuildProjectDirectory)/wwwroot/data/build-version.txt</ThemeVersionFile>
    <ThemeVersion Condition="'$(ThemeVersion)' == '' and '$(GITHUB_REF_TYPE)' == 'tag'">$(GITHUB_REF_NAME)</ThemeVersion>
    <ThemeVersion Condition="'$(ThemeVersion)' == '' and '$(InformationalVersion)' != ''">$(InformationalVersion)</ThemeVersion>
    <ThemeVersion Condition="'$(ThemeVersion)' == ''">$(Version)</ThemeVersion>
  </PropertyGroup>

  <Target Name="WriteThemeVersionFile" BeforeTargets="BeforeBuild">
    <Error
      Condition="'$(ThemeVersion)' == ''"
      Text="ThemeVersion could not be resolved. Set ThemeVersion, InformationalVersion, or Version explicitly." />
    <WriteLinesToFile
      File="$(ThemeVersionFile)"
      Lines="$(ThemeVersion)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.*" />
  </ItemGroup>

</Project>
